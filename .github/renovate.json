{
  "enabled": true,
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Never auto-merge major updates — a breaking major (typescript 7, the native compiler Next.js can't build with yet) reached production unreviewed. Majors now open a PR for manual review.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Pin TypeScript to the 5.x line until Next.js supports the TS7 (native/tsgo) compiler; 6.x is pre-release only.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6"
    },
    {
      "description": "Group non-major devDependencies into a single PR",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies (non-major)"
    },
    {
      "description": "Group non-major dependencies into a single PR",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dependencies (non-major)"
    }
  ],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "1 day",
  "automerge": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "schedule": ["before 6am"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
